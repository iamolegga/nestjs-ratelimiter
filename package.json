{
  "name": "nest-ratelimiter",
  "version": "0.4.0",
  "description": "Distributed consistent flexible NestJS rate limiter based on Redis",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "test": "vitest run",
    "lint": "tsc --noemit && biome check src __tests__",
    "lint:fix": "tsc --noemit && biome check --write src __tests__",
    "prebuild": "rimraf dist",
    "build": "tsc -p tsconfig.build.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamolegga/nestjs-ratelimiter.git"
  },
  "keywords": [
    "nest",
    "nestjs",
    "nest.js",
    "rate",
    "ratelimit",
    "ratelimiter",
    "limit",
    "limiter",
    "redis"
  ],
  "author": "iamolegga <iamolegga@gmail.com> (http://github.com/iamolegga)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/iamolegga/nestjs-ratelimiter/issues"
  },
  "homepage": "https://github.com/iamolegga/nestjs-ratelimiter#readme",
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "@types/ratelimiter": "^3.4.2",
    "ms": "^2.0.0",
    "ratelimiter": "^3.4.1"
  },
  "peerDependenciesMeta": {
    "ms": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "@swc/core": "^1.16.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.4.0",
    "@types/ratelimiter": "^3.4.6",
    "@types/redis-mock": "^0.17.3",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "ms": "^2.1.3",
    "ratelimiter": "^3.4.1",
    "redis-mock": "^0.56.3",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "supertest": "^7.0.0",
    "typescript": "^7.0.2",
    "unplugin-swc": "^1.5.11",
    "vitest": "^4.1.11"
  }
}
